        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "count(docker_container_cpu_usage_percent{container_name=~\"spark-master.*\"})",
          "legendFormat": "Masters Running",
          "range": true,
          "refId": "A"
