# ========================================================
# AZURA IOT - MODELE DE VARIABLES D'ENVIRONNEMENT (.env.example)
# Copiez ce fichier en '.env' et renseignez vos secrets reels.
# ========================================================

# --- SMTP EMAIL NOTIFICATIONS ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre_email@gmail.com
SMTP_PASSWORD=votre_mot_de_passe_application_16_caracteres
ALERT_EMAIL_RECIPIENT=destinataire_alertes@exemple.com

# --- VM ORACLE (INFRASTRUCTURE) ---
VM_PUBLIC_IP=votre_ip_publique_vm
